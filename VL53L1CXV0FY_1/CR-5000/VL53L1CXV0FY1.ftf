        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r50_50))
          (noconnect (pad r50_50))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r50_50))
          (noconnect (pad r50_50))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r50_50))
          (noconnect (pad r50_50))
        )
      )
    ); End of padstacks
